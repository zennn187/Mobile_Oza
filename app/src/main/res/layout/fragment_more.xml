<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E2230">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:paddingTop="24dp"
            android:paddingBottom="80dp"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/btnSettings"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="end"
                android:layout_marginBottom="8dp"
                android:src="@android:drawable/ic_menu_manage"
                app:tint="#9575CD"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Settings" />

            <androidx.cardview.widget.CardView
                android:layout_width="140dp"
                android:layout_height="140dp"
                app:cardCornerRadius="70dp"
                app:cardElevation="0dp"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="#2D3248">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="4dp"
                    app:cardCornerRadius="70dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/imgProfile"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/fotoprofile"
                        android:contentDescription="Foto Profil" />
                </androidx.cardview.widget.CardView>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tvProfileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Oza Okta Gistrada"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/montserrat_bold" />

            <TextView
                android:id="@+id/tvProfileRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full Stack Developer &amp; System Architect"
                android:textColor="#9AA1B1"
                android:textSize="13sp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="32dp"
                android:fontFamily="@font/montserrat_regular" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLinkedIn"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="LinkedIn"
                android:textColor="#FFFFFF"
                app:backgroundTint="#6200EE"
                app:cornerRadius="16dp"
                android:layout_marginBottom="14dp"
                android:textSize="15sp"
                android:fontFamily="@font/montserrat_bold"
                android:textAllCaps="false"
                app:icon="@drawable/ic_menu_my_places"
                app:iconTint="#FFFFFF"
                app:iconSize="22dp"
                app:iconPadding="16dp"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGitHub"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="GitHub"
                android:textColor="#FFFFFF"
                app:backgroundTint="#7E57C2"
                app:cornerRadius="16dp"
                android:layout_marginBottom="14dp"
                android:textSize="15sp"
                android:fontFamily="@font/montserrat_bold"
                android:textAllCaps="false"
                app:icon="@android:drawable/ic_menu_compass"
                app:iconTint="#FFFFFF"
                app:iconSize="22dp"
                app:iconPadding="16dp"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInstagram"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Instagram"
                android:textColor="#FFFFFF"
                app:backgroundTint="#9575CD"
                app:cornerRadius="16dp"
                android:layout_marginBottom="14dp"
                android:textSize="15sp"
                android:fontFamily="@font/montserrat_bold"
                android:textAllCaps="false"
                app:icon="@drawable/ic_mail"
                app:iconTint="#FFFFFF"
                app:iconSize="22dp"
                app:iconPadding="16dp"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSocialWhatsApp"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="WhatsApp Chat"
                android:textColor="#FFFFFF"
                app:backgroundTint="#25D366"
                app:cornerRadius="16dp"
                android:layout_marginBottom="36dp"
                android:textSize="15sp"
                android:fontFamily="@font/montserrat_bold"
                android:textAllCaps="false"
                app:icon="@android:drawable/stat_sys_phone_call"
                app:iconTint="#FFFFFF"
                app:iconSize="22dp"
                app:iconPadding="16dp"
                app:iconGravity="textStart" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="28dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#2D3248">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_menu_my_places"
                            app:tint="#9575CD" />
                        <TextView
                            android:id="@+id/tvLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Jl. Budi Sari No. 18, Pekanbaru"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:layout_marginStart="14dp"
                            android:fontFamily="@font/montserrat_medium" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#2D3248">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_menu_compass"
                            app:tint="#9575CD" />
                        <TextView
                            android:id="@+id/tvWebsite"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="https://oza.oktaa"
                            android:textColor="#9575CD"
                            android:textSize="13sp"
                            android:layout_marginStart="14dp"
                            android:fontFamily="@font/montserrat_medium" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#2D3248">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_calendar"
                            app:tint="#9AA1B1" />
                        <TextView
                            android:id="@+id/tvJoinedDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bergabung sejak: Januari 2024"
                            android:textColor="#9AA1B1"
                            android:textSize="13sp"
                            android:layout_marginStart="14dp"
                            android:fontFamily="@font/montserrat_medium" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabWhatsApp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:src="@android:drawable/stat_sys_phone_call"
        app:backgroundTint="#25D366"
        app:tint="@android:color/white"
        app:fabSize="normal"
        app:elevation="6dp"
        android:contentDescription="Hubungi via WhatsApp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>